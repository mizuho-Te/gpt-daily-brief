{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Dots Daily Brief dry-run configuration",
 "type":"object","additionalProperties":false,
 "required":["version","timezone","time","sources","destination","mode"],
 "properties":{
  "version":{"const":1},
  "timezone":{"type":"string","minLength":1,"description":"Valid IANA timezone, checked at runtime with Intl.DateTimeFormat"},
  "time":{"type":"string","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$"},
  "sources":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$","description":"Runtime validation additionally rejects dot-only repository names. This does not prove repository existence or public visibility."}},
  "destination":{"const":"current-chat"},"mode":{"const":"dry-run"}
 }
}
